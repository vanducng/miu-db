# Maintainer: Duc Nguyen <me@vanducng.dev>
# Original sqlit maintainer: Peter <peter.w.adams96@gmail.com>
pkgname=miu-db
pkgver=1.2.1.3
pkgrel=1
pkgdesc="A fast, modal TUI for SQL databases. Vim keys, 25+ adapters, zero config."
arch=('any')
url="https://github.com/vanducng/miu-db"
license=('MIT')
provides=('python-sqlit-tui' 'sqlit')
conflicts=('python-sqlit-tui' 'sqlit')
replaces=('python-sqlit-tui' 'sqlit')
depends=(
    'python'
    'python-textual'
    'python-textual-fastdatatable'
    'python-pyperclip'
    'python-keyring'
    'python-docker'
)
optdepends=(
    'python-psycopg2: PostgreSQL, CockroachDB and Supabase support'
    'python-pyodbc: SQL Server support'
    'python-pymysql: MySQL and MariaDB support'
    'python-oracledb: Oracle support'
    'python-duckdb: DuckDB support'
    'python-clickhouse-connect: ClickHouse support'
    'python-requests: Cloudflare D1 support'
    'python-snowflake-connector-python: Snowflake support'
    'python-paramiko: SSH tunnel support'
    'python-sshtunnel: SSH tunnel support'
)
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-hatch-vcs')
source=("https://files.pythonhosted.org/packages/source/m/miu-db/miu_db-${pkgver}.tar.gz")
sha256sums=('SKIP')  # regenerate via `updpkgsums` after the first miu-db sdist is on PyPI

build() {
    cd "miu_db-${pkgver}"
    python -m build --wheel --no-isolation
}

package() {
    cd "miu_db-${pkgver}"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
