Project "cnb-ai — Database Schema (cnb_ai)" {
  database_type: 'PostgreSQL'
}

Table agent_template_variables {
  id bigint unsigned [pk]
  agent_template_id bigint unsigned [not null]
  parent_agent_template_variable_id bigint unsigned
  variable varchar(255) [not null]
  label varchar(255) [not null]
  variable_type varchar(255) [not null]
  help_text text
  default_value text
  select_options json
  parent_option varchar(10)
  created_at timestamp
  updated_at timestamp
}

Table agent_templates {
  id bigint unsigned [pk]
  name varchar(255) [not null]
  description varchar(500)
  agent_id varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
  type varchar(255) [not null]
}

Table ai_agent_variable_values {
  id bigint unsigned [pk]
  ai_agent_id bigint unsigned [not null]
  agent_template_variable_id bigint unsigned [not null]
  value text
  created_at timestamp
  updated_at timestamp
}

Table ai_agents {
  id bigint unsigned [pk]
  name varchar(255) [not null]
  agent_trigger varchar(255) [not null]
  agent_template_id bigint unsigned [not null]
  phone_number varchar(255) [not null]
  voice_id varchar(255) [not null]
  pre_call_hooks json
  post_call_hooks json
  created_at timestamp
  updated_at timestamp
}

Table cache {
  key varchar(255) [pk]
  value mediumtext [not null]
  expiration int [not null]
}

Table cache_locks {
  key varchar(255) [pk]
  owner varchar(255) [not null]
  expiration int [not null]
}

Table failed_jobs {
  id bigint unsigned [pk]
  uuid varchar(255) [not null]
  connection text [not null]
  queue text [not null]
  payload longtext [not null]
  exception longtext [not null]
  failed_at timestamp [not null]
}

Table job_batches {
  id varchar(255) [pk]
  name varchar(255) [not null]
  total_jobs int [not null]
  pending_jobs int [not null]
  failed_jobs int [not null]
  failed_job_ids longtext [not null]
  options mediumtext
  cancelled_at int
  created_at int [not null]
  finished_at int
}

Table jobs {
  id bigint unsigned [pk]
  queue varchar(255) [not null]
  payload longtext [not null]
  attempts tinyint unsigned [not null]
  reserved_at int unsigned
  available_at int unsigned [not null]
  created_at int unsigned [not null]
}

Table migrations {
  id int unsigned [pk]
  migration varchar(255) [not null]
  batch int [not null]
}

Table password_reset_tokens {
  email varchar(255) [pk]
  token varchar(255) [not null]
  created_at timestamp
}

Table sessions {
  id varchar(255) [pk]
  user_id bigint unsigned
  ip_address varchar(45)
  user_agent text
  payload longtext [not null]
  last_activity int [not null]
}

Table users {
  id bigint unsigned [pk]
  name varchar(255) [not null]
  email varchar(255) [not null]
  email_verified_at timestamp
  password varchar(255) [not null]
  two_factor_secret text
  two_factor_recovery_codes text
  two_factor_confirmed_at timestamp
  remember_token varchar(100)
  created_at timestamp
  updated_at timestamp
}

Ref: agent_template_variables.agent_template_id > agent_templates.id [delete: cascade]
Ref: agent_template_variables.parent_agent_template_variable_id > agent_template_variables.id [delete: cascade]
Ref: ai_agent_variable_values.agent_template_variable_id > agent_template_variables.id [delete: cascade]
Ref: ai_agent_variable_values.ai_agent_id > ai_agents.id [delete: cascade]
Ref: ai_agents.agent_template_id > agent_templates.id [delete: cascade]

TableGroup "AI Agent Domain" {
  agent_templates
  agent_template_variables
  ai_agents
  ai_agent_variable_values
}

TableGroup "Auth & Users" {
  users
  sessions
  password_reset_tokens
}

TableGroup "Queue & Cache" {
  jobs
  job_batches
  failed_jobs
  cache
  cache_locks
}

TableGroup "System" {
  migrations
}
